# ---- Copy to .env and fill in. NEVER commit .env. ----

# App
ENV=development
# Required, min 32 chars. Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated browser origins allowed to call this API with credentials.
# Never *; a wildcard is illegal alongside credentialed CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (queue, rate limiting, cache)
REDIS_URL=redis://localhost:6379/0
# Rate limits live in app/core/policies.py, not here. Two deployment requirements:
# - Behind a proxy, run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy ip> (or the
#   FORWARDED_ALLOW_IPS env var). uvicorn reads it before the app imports, so a Settings field
#   would look correct and do nothing. Without it every client shares the proxy's bucket.
# - Instances need synced clocks (NTP): the bucket clock is time.time() in the app. A backwards
#   step only over-limits, but one instance running AHEAD refills every bucket it touches to
#   full, for everyone. A forward-skewed instance silently disables the limiter.
# - The limiter's Redis must run with maxmemory-policy noeviction. An evicted key is a bucket
#   reborn full, which is free budget for whoever drained it.

# Generation (local Ollama in dev)
# Ollama has no authentication: anyone who can reach the port can also pull, create and
# delete models. Never bind it to a routable interface.
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen3:8b
# Split deliberately: a cold model load is ~20s of legitimate waiting so the read timeout is
# generous, while 5s to connect fails fast when Ollama is not running at all.
GENERATION_TIMEOUT_SECONDS=180
GENERATION_CONNECT_TIMEOUT_SECONDS=5

# Chat (/chat endpoint)
# The document id ingest_cv.py printed when it seeded the CV. Required: startup fails without
# it. Scoping chat to one document explicitly is what stops Phase 5 uploads from being
# searchable by every other user; document_id=None would work today and leak later.
CV_DOCUMENT_ID=
# Below this cosine similarity, and with no full-text hit either, /chat refuses without calling
# the model. PROVISIONAL — replace with the value from scripts/calibrate_threshold.py.
# bge-small compresses similarity ranges, so a guessed threshold tends never to fire.
RETRIEVAL_SIMILARITY_THRESHOLD=0.45
RETRIEVAL_LIMIT=5
# Separate from GENERATION_TIMEOUT_SECONDS on purpose: 180s is fine for a CLI script, but on
# the request path 20 req/min against it permits ~60 concurrent generations per account. A
# request-rate limiter bounds arrivals, not concurrency; this bounds concurrency.
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_OUTPUT_TOKENS=512
CHAT_TEMPERATURE=0.0

# OpenAI — planned production provider, NOT READ BY ANYTHING YET. Settings has no openai
# field, so these are silently ignored (extra="ignore"). Uncomment when the adapter lands.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o

# Embeddings (local sentence-transformers, not OpenAI)
# All three change together. EMBEDDING_DIM must match the Vector(...) width in
# app/models/chunk.py, and EMBEDDING_MODEL_REVISION is a commit SHA in EMBEDDING_MODEL's own
# repo — a model change with a stale revision fails to load. Changing any of them means a
# migration plus a full re-embed, so all three are pinned and tests assert they agree.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIM=384

# S3 (CV file storage)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# File upload
MAX_UPLOAD_MB=10
