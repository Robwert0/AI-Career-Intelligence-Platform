# ---- Copy to .env and fill in. NEVER commit .env. ----

# App
ENV=development
# Required, min 32 chars. Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated browser origins allowed to call this API with credentials.
# Never *; a wildcard is illegal alongside credentialed CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (queue, rate limiting, cache)
REDIS_URL=redis://localhost:6379/0

# OpenAI (generation only — embeddings run locally, see below)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o

# Embeddings (local sentence-transformers, not OpenAI)
# All three change together. EMBEDDING_DIM must match the Vector(...) width in
# app/models/chunk.py, and EMBEDDING_MODEL_REVISION is a commit SHA in EMBEDDING_MODEL's own
# repo — a model change with a stale revision fails to load. Changing any of them means a
# migration plus a full re-embed, so all three are pinned and tests assert they agree.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIM=384

# S3 (CV file storage)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Rate limits
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_HOUR=5

# File upload
MAX_UPLOAD_MB=10
