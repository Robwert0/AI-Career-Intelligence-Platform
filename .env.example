# ---- Copy to .env and fill in. NEVER commit .env. ----

# App
ENV=development
# DEBUG | INFO | WARNING | ERROR. INFO is where the chat token/latency lines live.
LOG_LEVEL=INFO
# Required, min 32 chars. Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated browser origins allowed to call this API with credentials.
# Never *; a wildcard is illegal alongside credentialed CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (queue, rate limiting, cache)
REDIS_URL=redis://localhost:6379/0
# Rate limits live in app/core/policies.py, not here. Two deployment requirements:
# - Behind a proxy, run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy ip> (or the
#   FORWARDED_ALLOW_IPS env var). uvicorn reads it before the app imports, so a Settings field
#   would look correct and do nothing. Without it every client shares the proxy's bucket.
# - Instances need synced clocks (NTP): the bucket clock is time.time() in the app. A backwards
#   step only over-limits, but one instance running AHEAD refills every bucket it touches to
#   full, for everyone. A forward-skewed instance silently disables the limiter.
# - The limiter's Redis must run with maxmemory-policy noeviction. An evicted key is a bucket
#   reborn full, which is free budget for whoever drained it.

# Generation (local Ollama in dev)
# Ollama has no authentication: anyone who can reach the port can also pull, create and
# delete models. Never bind it to a routable interface.
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen3:8b
# Split deliberately: a cold model load is ~20s of legitimate waiting so the read timeout is
# generous, while 5s to connect fails fast when Ollama is not running at all.
GENERATION_TIMEOUT_SECONDS=180
GENERATION_CONNECT_TIMEOUT_SECONDS=5

# Chat (/chat endpoint)
# The document id ingest_cv.py printed when it seeded the CV. Required: startup fails without
# it. Scoping chat to one document explicitly is what stops Phase 5 uploads from being
# searchable by every other user; document_id=None would work today and leak later.
CV_DOCUMENT_ID=
# Below this cosine similarity, /chat refuses without calling the model. CALIBRATED 2026-09-22
# against the real 7-chunk CV with scripts/calibrate_threshold.py: answerable questions scored
# 0.506-0.651 and unanswerable ones 0.418-0.659 — overlapping, so no value separates them cleanly.
# 0.48 sits below the lowest legitimate question with ~0.026 of margin and still catches the
# clearly off-topic ones for free. It errs towards answering on purpose: a wrongly refused question
# is a visible product failure, whereas a missed refusal is caught by the prompt-level refusal
# instruction — which is measured doing exactly that on every near-miss tested.
# Re-run the script whenever the CV changes; the numbers are corpus-specific.
RETRIEVAL_SIMILARITY_THRESHOLD=0.48
RETRIEVAL_LIMIT=5
# Separate from GENERATION_TIMEOUT_SECONDS on purpose: 180s is fine for a CLI script but far
# too long to hold a request open. This bounds DURATION, not concurrency -- a request-rate
# limiter bounds arrivals and a timeout bounds how long each one lives; neither caps how many
# run at once. CHAT_MAX_CONCURRENT_GENERATIONS is what actually bounds concurrency.
# A cold Ollama model load is ~20s, so the first request after an idle period can exceed this
# and return 503; warm generations take a few seconds.
CHAT_TIMEOUT_SECONDS=30
# The real concurrency bound: how many generations may run at once in this process. Without it
# one account's burst (CHAT_USER capacity 20) could pin every worker for the full timeout.
CHAT_MAX_CONCURRENT_GENERATIONS=4
# How long a request waits for a free slot before giving up with 503 + Retry-After.
CHAT_QUEUE_TIMEOUT_SECONDS=5
CHAT_MAX_OUTPUT_TOKENS=512
CHAT_TEMPERATURE=0.0

# OpenAI — planned production provider, NOT READ BY ANYTHING YET. Settings has no openai
# field, so these are silently ignored (extra="ignore"). Uncomment when the adapter lands.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o

# Embeddings (local sentence-transformers, not OpenAI)
# All three change together. EMBEDDING_DIM must match the Vector(...) width in
# app/models/chunk.py, and EMBEDDING_MODEL_REVISION is a commit SHA in EMBEDDING_MODEL's own
# repo — a model change with a stale revision fails to load. Changing any of them means a
# migration plus a full re-embed, so all three are pinned and tests assert they agree.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIM=384

# S3 (CV file storage)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# File upload: CV uploads for the Job Match Analyzer (1-20; read by Settings.max_upload_mb).
# The frontend reads the effective byte limit from GET /match/config, so never hard-code it.
MAX_UPLOAD_MB=5

# --- Background jobs (Celery) ---
# Separate Redis DB from REDIS_URL so a broker flush never touches rate-limit buckets.
CELERY_BROKER_URL=redis://localhost:6379/1
# Record lifetime, and also the broker's visibility_timeout. Settings requires it to be at
# least JOB_QUEUE_STALE_SECONDS + MATCH_ANALYSIS_SOFT_TIME_LIMIT_SECONDS + 30 (2730 with the
# defaults), so a queued analysis can finish before its record expires.
JOB_TTL_SECONDS=3600
# Job intake only; analyses have their own MATCH_ANALYSIS_SOFT_TIME_LIMIT_SECONDS.
JOB_SOFT_TIME_LIMIT_SECONDS=300
# Ollama context window for every call, chat and job intake alike. A prompt that doesn't fit is
# refused, never truncated; for a job posting that surfaces as input_too_long.
GENERATION_CONTEXT_TOKENS=16384
JOB_EXTRACT_GENERATION_TIMEOUT_SECONDS=120
# A job still queued after this long is shown as failed (queue_unavailable).
JOB_QUEUE_STALE_SECONDS=900

# --- Job Match Analyzer: candidate evidence ---
# Optional. Without it every user shares GitHub's 60 requests/hour: about 2 new profiles.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=3600
EVIDENCE_EXTRACT_GENERATION_TIMEOUT_SECONDS=150

# --- Job Match Analyzer: analysis ---
# Must exceed JOB_QUEUE_STALE_SECONDS: a CV has to survive the longest wait in the queue.
MATCH_CV_TTL_SECONDS=1200
# Analyses allowed to wait in the queue at once, across all users; past it: 503 queue_full.
MATCH_MAX_QUEUED_ANALYSES=20
# Workers: `celery -A app.workers.celery_app worker` consumes every queue. To keep job intake
# responsive behind long analyses, run two: `... worker -Q intake,celery -n intake@%h` and
# `... worker -Q analysis -n analysis@%h`.
MATCH_PRESELECT_TOP_K=8
# Refusal gates, one per source (defaults in config.py; override here). The statistic is each
# source's mean, over the posting's requirements, of that requirement's best evidence match.
# Measured 2026-09-28 by `scripts/eval_match.py calibrate` on Robert's CV and github.com/Robwert0
# against 10 related and 14 unrelated postings:
#   CV:     related 0.6251..0.6737, unrelated 0.5080..0.5841 -> midpoint 0.605 (margin 0.0205)
#   GitHub: related 0.5876..0.6401, unrelated 0.5126..0.5788 -> midpoint 0.583 (margin 0.0044)
# Re-measure if the embedding model, the evidence text or the statistic changes.
MATCH_PRESELECT_MIN_SIMILARITY=0.605
MATCH_PRESELECT_MIN_SIMILARITY_GITHUB=0.583
MATCH_ASSESS_GENERATION_TIMEOUT_SECONDS=60
MATCH_RECOMMEND_GENERATION_TIMEOUT_SECONDS=90
# Must exceed the worst case (1580s with the defaults above); Settings refuses anything smaller.
MATCH_ANALYSIS_SOFT_TIME_LIMIT_SECONDS=1800
