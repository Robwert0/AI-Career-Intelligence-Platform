# Server-side only. Never prefix NEXT_PUBLIC_ -- rewrites are evaluated by the Next server and
# the browser must never learn the backend address; that is the point of the proxy.
BACKEND_ORIGIN=http://localhost:8000

# Umami Cloud analytics. Leave unset in dev/CI: no script is loaded and no events are sent.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Comma-separated hostnames that may report, e.g. robertmirea.dev, so preview deploys stay out.
NEXT_PUBLIC_UMAMI_DOMAINS=
# Link shown on /admin to the Umami dashboard (or a share URL).
NEXT_PUBLIC_UMAMI_DASHBOARD_URL=
